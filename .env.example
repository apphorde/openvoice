# Required for public network access; the app redirects to the issuer.
OIDC_ISSUER=https://auth.api.apphor.de
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_URL=https://openvoice.apphor.de
# Optional OpenCode server settings (credentials never go to the browser)
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Do not expose without OIDC and HTTPS.
HOST=127.0.0.1
PORT=4173
POLL_INTERVAL_MS=5000
DATA_FILE=/data/session-voice/goals.json
# Optional; separate from OpenCode's model credentials.
OPENAI_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
